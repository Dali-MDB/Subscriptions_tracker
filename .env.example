# MongoDB connection string (same format as mongosh / Compass)
# Example: mongodb://127.0.0.1:27017/subscriptions_tracker
# Atlas: mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
DB_URL=

# Secret used to sign JWT access and refresh tokens (use a long random string in production)
JWT_SECRET_KEY=

# Access token lifetime in minutes (number only — the app appends "m")
JWT_EXP_ACCESS=15

# Refresh token lifetime in days (number only — the app appends "d")
JWT_EXP_REFRESH=7
